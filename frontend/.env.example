# Backend API Base URL
# In development with Vite proxy, leave empty or set to /api
# In production, set to your backend deployment URL e.g. https://api.yourdomain.com
VITE_API_URL=/api

# Clerk Authentication (Public Publishable Key)
# Obtain this from your Clerk Dashboard -> API Keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
